# Copy to .env and edit. Everything is optional.
HOST=0.0.0.0
PORT=8000
# API_KEY=change-me            # if set, clients must send header  X-API-Key: <key>
# CORS_ORIGINS=*              # browsers allowed to call the API: * or https://app.com,http://localhost:5173

# Image storage: Cloudflare R2 (or any S3-compatible bucket). Leave empty to save into ./outputs.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_REGION=auto
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_PREFIX=qwen/              # object key = <prefix><job id>.<ext>
# R2_URL_EXPIRES=604800        # signed URL lifetime in seconds (max 7 days)
# R2_PUBLIC_BASE_URL=https://images.example.com   # if the bucket has a public domain: plain URLs, no signing

# Job history: one row per image in Postgres (e.g. Neon). Leave empty to keep it in memory only.
DATABASE_URL=              # use single quotes: DATABASE_URL='postgresql://user:pass@host/db?sslmode=require&channel_binding=require'
# DB_TABLE=qwen_images         # created automatically on startup

# Queue
# QUEUE_MAX=100                # max jobs waiting; more -> HTTP 429
# JOBS_KEEP=1000               # finished jobs kept in memory for GET /jobs

# Engine
# COMFY_PORT=8189              # internal ComfyUI port (bound to 127.0.0.1)
# COMFY_URL=http://127.0.0.1:8188   # attach to an already-running ComfyUI instead of starting one
# COMFY_ARGS=--lowvram         # extra ComfyUI flags
# DIFFUSION_MODEL=qwen_image_2.1_bf16.safetensors   # after MODEL_SET=bf16 download
# TEXT_ENCODER=qwen3vl_8b_bf16.safetensors
