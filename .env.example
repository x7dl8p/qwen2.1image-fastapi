# Copy to .env and edit. All optional.
HOST=0.0.0.0
PORT=8000
# API_KEY=change-me            # if set, clients must send header  X-API-Key: <key>
# COMFY_PORT=8189              # internal ComfyUI port (bound to 127.0.0.1)
# COMFY_URL=http://127.0.0.1:8188   # attach to an already-running ComfyUI instead of starting one
# COMFY_ARGS=--lowvram         # extra ComfyUI flags
# DIFFUSION_MODEL=qwen_image_2.1_bf16.safetensors   # after MODEL_SET=bf16 download
# TEXT_ENCODER=qwen3vl_8b_bf16.safetensors
